# Enquiry delivery for /api/contact. Set these in the Vercel project settings (never commit real values).

# Inbox that receives every form submission (comma-separate for several)
CONTACT_TO_EMAIL=support@bharatfundaxis.com
# Sender address; must be allowed by the mail provider below
CONTACT_FROM_EMAIL=BharatFundAxis Website <noreply@bharatfundaxis.com>

# Option A: SMTP via Nodemailer (used when SMTP_HOST is set), e.g. the bharatfundaxis.com mailbox
# (Google Workspace: smtp.gmail.com + an app password; Zoho: smtp.zoho.in; Hostinger: smtp.hostinger.com)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Option B: Resend (used when SMTP_HOST is empty); the sender domain must be verified in Resend
RESEND_API_KEY=

# Optional: WhatsApp Business Cloud API alert for each enquiry
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Business number that receives the alert, with country code, digits only (e.g. 91XXXXXXXXXX)
WHATSAPP_TO=
# Approved message template with one {{1}} body variable; without it, alerts only arrive inside a 24-hour chat window
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Optional: Vercel KV / Upstash Redis. Stores every enquiry (list "enquiries") and makes the rate limit global
KV_REST_API_URL=
KV_REST_API_TOKEN=
